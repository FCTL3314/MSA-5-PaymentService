<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_PaymentSaga"
                  targetNamespace="http://orchestrpay.example/bpmn"
                  exporter="hand-written"
                  exporterVersion="1.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.9.0">

  <bpmn:message id="Message_CustomerCancelled" name="CustomerCancelled">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=paymentId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Error_LimitExceeded" name="Лимит превышен" errorCode="LIMIT_EXCEEDED" />
  <bpmn:error id="Error_DebitDeclined" name="Банк отказал в списании" errorCode="DEBIT_DECLINED" />
  <bpmn:error id="Error_TransferRejected" name="Перевод отклонён" errorCode="TRANSFER_REJECTED" />

  <bpmn:process id="payment-saga" name="Обработка платежа OrchestrPay (Saga-оркестрация)" isExecutable="true">

    <!-- ===================== Основной поток ===================== -->
    <bpmn:startEvent id="Start_PaymentInitiated" name="Платёж инициирован">
      <bpmn:outgoing>Flow_Start_Create</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_CreatePayment" name="Создать платёж&#10;CREATE_PAYMENT">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-payment" retries="5" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Create</bpmn:incoming>
      <bpmn:outgoing>Flow_Create_Limits</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_ReserveLimits" name="Зарезервировать лимиты&#10;RESERVE_LIMITS">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reserve-limits" retries="5" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Create_Limits</bpmn:incoming>
      <bpmn:outgoing>Flow_Limits_Debit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_DebitFunds" name="Списать деньги клиента&#10;DEBIT_FUNDS">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="debit-funds" retries="5" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Limits_Debit</bpmn:incoming>
      <bpmn:outgoing>Flow_Debit_Fraud</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_FraudCheck" name="Антифрод-проверка&#10;FRAUD_CHECK">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fraud-check" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Debit_Fraud</bpmn:incoming>
      <bpmn:outgoing>Flow_Fraud_Decision</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_FraudDecision" name="Решение антифрода?" default="Flow_Decision_Deny">
      <bpmn:incoming>Flow_Fraud_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Decision_Allow</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision_Manual</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision_Deny</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ManualReview" name="Ручная проверка оператором&#10;MANUAL_FRAUD_REVIEW">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="manual-review-form" />
        <zeebe:assignmentDefinition candidateGroups="fraud-operators" />
        <zeebe:priorityDefinition priority="80" />
        <zeebe:taskSchedule dueDate="=now() + duration(manualReviewTimeout)" />
        <zeebe:ioMapping>
          <zeebe:output source="=fraudDecision" target="fraudDecision" />
          <zeebe:output source="=operatorComment" target="operatorComment" />
          <zeebe:output source="=&quot;OPERATOR&quot;" target="fraudDecisionSource" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Decision_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_Manual_OperatorDecision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_OperatorDecision" name="Решение оператора?" default="Flow_Operator_Deny">
      <bpmn:incoming>Flow_Manual_OperatorDecision</bpmn:incoming>
      <bpmn:incoming>Flow_ManualCutOff_OperatorDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_Operator_Allow</bpmn:outgoing>
      <bpmn:outgoing>Flow_Operator_Deny</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:intermediateThrowEvent id="Event_FraudCutOffAllow" name="Разрешено по cut-off">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&quot;ALLOW&quot;" target="fraudDecision" />
          <zeebe:output source="=&quot;CUT_OFF&quot;" target="fraudDecisionSource" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FraudCutOff_Event</bpmn:incoming>
      <bpmn:outgoing>Flow_FraudCutOff_AllowMerge</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:intermediateThrowEvent id="Event_ManualCutOffAllow" name="Разрешено по cut-off">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&quot;ALLOW&quot;" target="fraudDecision" />
          <zeebe:output source="=&quot;CUT_OFF&quot;" target="fraudDecisionSource" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ManualCutOff_Event</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualCutOff_OperatorDecision</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:exclusiveGateway id="Gateway_AllowMerge">
      <bpmn:incoming>Flow_Decision_Allow</bpmn:incoming>
      <bpmn:incoming>Flow_FraudCutOff_AllowMerge</bpmn:incoming>
      <bpmn:incoming>Flow_Operator_Allow</bpmn:incoming>
      <bpmn:outgoing>Flow_AllowMerge_Transfer</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_TransferToMerchant" name="Перевести деньги контрагенту&#10;TRANSFER_TO_MERCHANT">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="transfer-to-merchant" retries="5" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AllowMerge_Transfer</bpmn:incoming>
      <bpmn:outgoing>Flow_Transfer_Complete</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_CompletePayment" name="Завершить платёж&#10;COMPLETE_PAYMENT">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="complete-payment" retries="10" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Transfer_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete_Notify</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_NotifySuccess" name="Уведомить об оплате&#10;NOTIFY_CUSTOMER">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-customer" retries="10" />
        <zeebe:taskHeaders>
          <zeebe:header key="template" value="PAYMENT_COMPLETED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Complete_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_PaymentCompleted" name="Платёж проведён">
      <bpmn:incoming>Flow_Notify_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ===================== Граничные события ===================== -->
    <bpmn:boundaryEvent id="Boundary_CompCreatePayment" attachedToRef="Task_CreatePayment">
      <bpmn:compensateEventDefinition id="CompDef_CreatePayment" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_CompReserveLimits" attachedToRef="Task_ReserveLimits">
      <bpmn:compensateEventDefinition id="CompDef_ReserveLimits" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_CompDebitFunds" attachedToRef="Task_DebitFunds">
      <bpmn:compensateEventDefinition id="CompDef_DebitFunds" />
    </bpmn:boundaryEvent>

    <bpmn:boundaryEvent id="Boundary_LimitExceeded" name="Лимит превышен" attachedToRef="Task_ReserveLimits">
      <bpmn:outgoing>Flow_LimitExceeded_Link</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_LimitExceeded" errorRef="Error_LimitExceeded" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_DebitDeclined" name="Банк отказал" attachedToRef="Task_DebitFunds">
      <bpmn:outgoing>Flow_DebitDeclined_Link</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_DebitDeclined" errorRef="Error_DebitDeclined" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_FraudCutOff" name="Cut-off" attachedToRef="Task_FraudCheck">
      <bpmn:outgoing>Flow_FraudCutOff_Event</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_FraudCutOff">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=fraudCheckCutOff</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_CustomerCancelled" name="Клиент отменил платёж" attachedToRef="Task_ManualReview">
      <bpmn:outgoing>Flow_CustomerCancelled_Link</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_CustomerCancelled" messageRef="Message_CustomerCancelled" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_ManualCutOff" name="20 минут" attachedToRef="Task_ManualReview">
      <bpmn:outgoing>Flow_ManualCutOff_Event</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_ManualCutOff">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=manualReviewTimeout</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_TransferRejected" name="Перевод отклонён" attachedToRef="Task_TransferToMerchant">
      <bpmn:outgoing>Flow_TransferRejected_Link</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_TransferRejected" errorRef="Error_TransferRejected" />
    </bpmn:boundaryEvent>

    <!-- ===================== Компенсирующие обработчики ===================== -->
    <bpmn:serviceTask id="Task_CancelPayment" name="Отменить платёж&#10;CANCEL_PAYMENT" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cancel-payment" retries="10" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ReleaseLimits" name="Снять резерв лимитов&#10;RELEASE_LIMITS" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="release-limits" retries="10" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RefundFunds" name="Вернуть деньги клиенту&#10;REFUND_FUNDS" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="refund-funds" retries="10" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- ===================== Переходы к компенсации (link events) ===================== -->
    <bpmn:intermediateThrowEvent id="Link_FromLimits" name="Компенсация">
      <bpmn:incoming>Flow_LimitExceeded_Link</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkDef_FromLimits" name="compensation" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Link_FromDebit" name="Компенсация">
      <bpmn:incoming>Flow_DebitDeclined_Link</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkDef_FromDebit" name="compensation" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Link_FromFraudDeny" name="Компенсация">
      <bpmn:incoming>Flow_Decision_Deny</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkDef_FromFraudDeny" name="compensation" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Link_FromCustomerCancel" name="Компенсация">
      <bpmn:incoming>Flow_CustomerCancelled_Link</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkDef_FromCustomerCancel" name="compensation" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Link_FromOperatorDeny" name="Компенсация">
      <bpmn:incoming>Flow_Operator_Deny</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkDef_FromOperatorDeny" name="compensation" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Link_FromTransfer" name="Компенсация">
      <bpmn:incoming>Flow_TransferRejected_Link</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkDef_FromTransfer" name="compensation" />
    </bpmn:intermediateThrowEvent>

    <!-- ===================== Компенсация ===================== -->
    <bpmn:intermediateCatchEvent id="Link_CompensationStart" name="Компенсация">
      <bpmn:outgoing>Flow_CompStart_Split</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LinkDef_CompensationStart" name="compensation" />
    </bpmn:intermediateCatchEvent>

    <bpmn:inclusiveGateway id="Gateway_CompSplit">
      <bpmn:incoming>Flow_CompStart_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_Split_Refund</bpmn:outgoing>
      <bpmn:outgoing>Flow_Split_Security</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:intermediateThrowEvent id="Event_CompRefund" name="Вернуть деньги">
      <bpmn:incoming>Flow_Split_Refund</bpmn:incoming>
      <bpmn:outgoing>Flow_CompRefund_CompLimits</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompThrow_DebitFunds" activityRef="Task_DebitFunds" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_CompLimits" name="Снять резерв лимитов">
      <bpmn:incoming>Flow_CompRefund_CompLimits</bpmn:incoming>
      <bpmn:outgoing>Flow_CompLimits_CompPayment</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompThrow_ReserveLimits" activityRef="Task_ReserveLimits" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_CompPayment" name="Отменить платёж">
      <bpmn:incoming>Flow_CompLimits_CompPayment</bpmn:incoming>
      <bpmn:outgoing>Flow_CompPayment_Join</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompThrow_CreatePayment" activityRef="Task_CreatePayment" />
    </bpmn:intermediateThrowEvent>

    <bpmn:serviceTask id="Task_NotifySecurity" name="Уведомить СБ&#10;NOTIFY_SECURITY">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-security" retries="10" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Split_Security</bpmn:incoming>
      <bpmn:outgoing>Flow_Security_Join</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:inclusiveGateway id="Gateway_CompJoin">
      <bpmn:incoming>Flow_CompPayment_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Security_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_NotifyFailure</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:serviceTask id="Task_NotifyFailure" name="Уведомить об отмене&#10;NOTIFY_CUSTOMER">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-customer" retries="10" />
        <zeebe:taskHeaders>
          <zeebe:header key="template" value="PAYMENT_NOT_COMPLETED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Join_NotifyFailure</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyFailure_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_PaymentNotCompleted" name="Платёж не проведён, деньги возвращены">
      <bpmn:incoming>Flow_NotifyFailure_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ===================== Последовательности ===================== -->
    <bpmn:sequenceFlow id="Flow_Start_Create" sourceRef="Start_PaymentInitiated" targetRef="Task_CreatePayment" />
    <bpmn:sequenceFlow id="Flow_Create_Limits" sourceRef="Task_CreatePayment" targetRef="Task_ReserveLimits" />
    <bpmn:sequenceFlow id="Flow_Limits_Debit" sourceRef="Task_ReserveLimits" targetRef="Task_DebitFunds" />
    <bpmn:sequenceFlow id="Flow_Debit_Fraud" sourceRef="Task_DebitFunds" targetRef="Task_FraudCheck" />
    <bpmn:sequenceFlow id="Flow_Fraud_Decision" sourceRef="Task_FraudCheck" targetRef="Gateway_FraudDecision" />
    <bpmn:sequenceFlow id="Flow_Decision_Allow" name="Разрешение" sourceRef="Gateway_FraudDecision" targetRef="Gateway_AllowMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fraudDecision = "ALLOW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Decision_Manual" name="Ручная проверка" sourceRef="Gateway_FraudDecision" targetRef="Task_ManualReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fraudDecision = "MANUAL_REVIEW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Decision_Deny" name="Запрет" sourceRef="Gateway_FraudDecision" targetRef="Link_FromFraudDeny" />
    <bpmn:sequenceFlow id="Flow_Manual_OperatorDecision" sourceRef="Task_ManualReview" targetRef="Gateway_OperatorDecision" />
    <bpmn:sequenceFlow id="Flow_Operator_Allow" name="Разрешение" sourceRef="Gateway_OperatorDecision" targetRef="Gateway_AllowMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fraudDecision = "ALLOW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Operator_Deny" name="Запрет" sourceRef="Gateway_OperatorDecision" targetRef="Link_FromOperatorDeny" />
    <bpmn:sequenceFlow id="Flow_FraudCutOff_Event" sourceRef="Boundary_FraudCutOff" targetRef="Event_FraudCutOffAllow" />
    <bpmn:sequenceFlow id="Flow_FraudCutOff_AllowMerge" sourceRef="Event_FraudCutOffAllow" targetRef="Gateway_AllowMerge" />
    <bpmn:sequenceFlow id="Flow_ManualCutOff_Event" sourceRef="Boundary_ManualCutOff" targetRef="Event_ManualCutOffAllow" />
    <bpmn:sequenceFlow id="Flow_ManualCutOff_OperatorDecision" sourceRef="Event_ManualCutOffAllow" targetRef="Gateway_OperatorDecision" />
    <bpmn:sequenceFlow id="Flow_AllowMerge_Transfer" sourceRef="Gateway_AllowMerge" targetRef="Task_TransferToMerchant" />
    <bpmn:sequenceFlow id="Flow_Transfer_Complete" sourceRef="Task_TransferToMerchant" targetRef="Task_CompletePayment" />
    <bpmn:sequenceFlow id="Flow_Complete_Notify" sourceRef="Task_CompletePayment" targetRef="Task_NotifySuccess" />
    <bpmn:sequenceFlow id="Flow_Notify_End" sourceRef="Task_NotifySuccess" targetRef="End_PaymentCompleted" />
    <bpmn:sequenceFlow id="Flow_LimitExceeded_Link" sourceRef="Boundary_LimitExceeded" targetRef="Link_FromLimits" />
    <bpmn:sequenceFlow id="Flow_DebitDeclined_Link" sourceRef="Boundary_DebitDeclined" targetRef="Link_FromDebit" />
    <bpmn:sequenceFlow id="Flow_CustomerCancelled_Link" sourceRef="Boundary_CustomerCancelled" targetRef="Link_FromCustomerCancel" />
    <bpmn:sequenceFlow id="Flow_TransferRejected_Link" sourceRef="Boundary_TransferRejected" targetRef="Link_FromTransfer" />
    <bpmn:sequenceFlow id="Flow_CompStart_Split" sourceRef="Link_CompensationStart" targetRef="Gateway_CompSplit" />
    <bpmn:sequenceFlow id="Flow_Split_Refund" name="всегда" sourceRef="Gateway_CompSplit" targetRef="Event_CompRefund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Split_Security" name="Запрет антифрода" sourceRef="Gateway_CompSplit" targetRef="Task_NotifySecurity">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fraudDecision = "DENY"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CompRefund_CompLimits" sourceRef="Event_CompRefund" targetRef="Event_CompLimits" />
    <bpmn:sequenceFlow id="Flow_CompLimits_CompPayment" sourceRef="Event_CompLimits" targetRef="Event_CompPayment" />
    <bpmn:sequenceFlow id="Flow_CompPayment_Join" sourceRef="Event_CompPayment" targetRef="Gateway_CompJoin" />
    <bpmn:sequenceFlow id="Flow_Security_Join" sourceRef="Task_NotifySecurity" targetRef="Gateway_CompJoin" />
    <bpmn:sequenceFlow id="Flow_Join_NotifyFailure" sourceRef="Gateway_CompJoin" targetRef="Task_NotifyFailure" />
    <bpmn:sequenceFlow id="Flow_NotifyFailure_End" sourceRef="Task_NotifyFailure" targetRef="End_PaymentNotCompleted" />

    <bpmn:association id="Assoc_CompCreatePayment" associationDirection="One" sourceRef="Boundary_CompCreatePayment" targetRef="Task_CancelPayment" />
    <bpmn:association id="Assoc_CompReserveLimits" associationDirection="One" sourceRef="Boundary_CompReserveLimits" targetRef="Task_ReleaseLimits" />
    <bpmn:association id="Assoc_CompDebitFunds" associationDirection="One" sourceRef="Boundary_CompDebitFunds" targetRef="Task_RefundFunds" />

    <!-- ===================== Аннотации ===================== -->
    <bpmn:textAnnotation id="Note_Compensation">
      <bpmn:text>Компенсирующие транзакции: идемпотентны и повторяются до успеха. Вызываются только для завершённых шагов</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_Compensation" sourceRef="Note_Compensation" targetRef="Task_ReleaseLimits" />
    <bpmn:textAnnotation id="Note_CutOff">
      <bpmn:text>Cut-off-time: антифрод не ответил вовремя → разрешено по умолчанию. Поздний «Запрет» уходит в процесс пост-фактум возврата</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_CutOff" sourceRef="Note_CutOff" targetRef="Event_FraudCutOffAllow" />
    <bpmn:textAnnotation id="Note_Pivot">
      <bpmn:text>Pivot-транзакция: после перевода откат невозможен</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_Pivot" sourceRef="Note_Pivot" targetRef="Task_TransferToMerchant" />
    <bpmn:textAnnotation id="Note_Retriable">
      <bpmn:text>Повторяемые транзакции: retry с backoff, при исчерпании — инцидент в Operate</bpmn:text>
    </bpmn:textAnnotation>
